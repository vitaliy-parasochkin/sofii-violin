---
import { Picture } from 'astro:assets';
// Статичне фото замість відео (рішення 2026-11-12: відео не сподобалось, на телефоні без сенсу).
import heroPhoto from '../assets/photos/hero.jpg';
import { TEACHER } from '../data/site';
import CtaButton from './CtaButton.astro';
import HandArrow from './HandArrow.astro';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__media">
    <Picture
      src={heroPhoto}
      alt="Софія грає на скрипці в студії"
      formats={['avif', 'webp']}
      widths={[390, 600, 800, 1080, 1440]}
      sizes="(min-width: 48rem) 53vw, 100vw"
      priority
      class="hero__photo"
    />
  </div>

  <div class="container hero__grid">
    <div class="hero__text">
      <h1 id="hero-title" class="hero__title">
        Уроки скрипки онлайн <em>для&nbsp;дорослих і&nbsp;дітей</em>
      </h1>

      <p class="hero__lead">
        Привіт, я Софія. Граю на скрипці {TEACHER.yearsPlaying}&nbsp;років, а {TEACHER.yearsTeaching}&nbsp;з них навчаю
        інших: і дорослих, які починають з нуля, і дітей. Займаємося один на один, тож поспішати нікуди.
      </p>

      <div class="hero__actions">
        <CtaButton />
        <HandArrow class="hero__arrow" />
      </div>

      <ul class="hero__facts">
        <li><strong>50 хвилин</strong> один на один</li>
        <li><strong>Google Meet</strong> з телефона чи ноутбука</li>
        <li><strong>З будь-якої країни</strong> українською</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block-end: var(--space-xl);
    overflow-x: clip;
  }

  /* ——— Фото ———
     Без рамок: краї м'яко розчиняються у фон.
     Телефон: смуга на всю ширину зверху, низ плавно переходить у текст. */
  .hero__media {
    position: relative;
    overflow: hidden;
    height: clamp(16rem, 40svh, 27rem); /* кнопка запису лишається на першому екрані */
    -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent);
    mask-image: linear-gradient(to bottom, #000 72%, transparent);
  }

  .hero__media :global(.hero__photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%; /* у смугу на телефоні — обличчя і скрипка */
  }

  /* Легке затемнення кадру (теплим еспресо, не чорним) */
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: rgb(59 42 32 / 0.12);
  }

  .hero__grid {
    position: relative;
    display: grid;
    gap: var(--space-l);
    margin-top: var(--space-m);
  }

  /* ——— Поява при завантаженні: CSS-анімація стартує з першим кадром (без JS) ——— */
  @media (prefers-reduced-motion: no-preference) {
    .hero__title,
    .hero__lead,
    .hero__actions,
    .hero__facts {
      animation: hero-in var(--duration-slow) var(--ease-out) both;
    }

    .hero__lead {
      animation-delay: 100ms;
    }

    .hero__actions {
      animation-delay: 200ms;
    }

    .hero__facts {
      animation-delay: 300ms;
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      translate: 0 16px;
    }
  }

  /* ——— Текст ——— */
  .hero__title {
    font-size: var(--text-display);
    font-weight: var(--weight-medium);
    letter-spacing: -0.01em;
  }

  .hero__title em {
    display: block;
    color: var(--color-accent); /* великий текст — контраст достатній */
    font-style: italic;
  }

  .hero__lead {
    max-width: 34rem;
    margin-top: var(--space-m);
    color: var(--color-muted);
    font-size: var(--text-lg);
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-s);
    margin-top: var(--space-l);
  }

  /* :global — клас передається в дочірній компонент.
     Стрілочка вказує на кнопку — лише там, де поруч із кнопкою вистачає місця */
  .hero__actions :global(.hero__arrow) {
    display: none;
  }

  @media (min-width: 80rem) {
    .hero__actions {
      flex-direction: row;
      align-items: center;
    }

    .hero__actions > :global(:first-child) {
      flex-shrink: 0; /* кнопка не стискається через стрілочку */
    }

    .hero__actions :global(.hero__arrow) {
      display: block;
      flex-shrink: 0;
      width: 3.75rem;
      height: auto;
      transform: translateY(-0.4rem) rotate(-6deg);
    }
  }

  /* ——— Факти рядком під кнопкою ——— */
  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    margin-top: var(--space-m);
    padding: var(--space-s) 0 0;
    list-style: none;
    border-top: var(--border-thin);
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
  }

  .hero__facts li {
    position: relative;
    padding-left: 0.9rem;
  }

  .hero__facts li::before {
    content: '';
    position: absolute;
    top: 0.65em;
    left: 0;
    width: 0.5rem;
    height: 1px;
    background-color: var(--color-accent);
  }

  .hero__facts strong {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }

  /* ——— Планшет і більше: фото — ліва половина екрана, текст — праворуч ——— */
  @media (min-width: 48rem) {
    /* Hero = рівно перший екран (хедер на hero схований і місця не займає); відступи й заголовок
       підлаштовуються під висоту вікна, щоб усе вміщалось. */
    .hero {
      display: grid;
      align-content: center;
      min-height: calc(100svh - var(--header-space));
      padding-block: clamp(var(--space-s), 4svh, var(--space-xl));
    }

    .hero__title {
      /* і за висотою вікна, і за шириною колонки — щоб «для дорослих» не рвалось посеред слова на планшеті */
      font-size: min(var(--text-display), 7svh, 5.6vw);
    }

    .hero__lead {
      font-size: min(var(--text-lg), 2.3svh);
    }

    /* Ліва половина, висота — перший екран (навіть якщо текст довший).
       Правий край прямо розчиняється в текст, низ — у наступну секцію (маски перетинаються). */
    .hero__media {
      --hero-fade: linear-gradient(to left, transparent, #000 22%);
      position: absolute;
      inset: 0 auto auto 0;
      width: 54%;
      height: calc(100svh - var(--header-space));
      -webkit-mask-image: var(--hero-fade), linear-gradient(to top, transparent, #000 14%);
      -webkit-mask-size: 100% 100%;
      -webkit-mask-repeat: no-repeat;
      -webkit-mask-composite: source-in;
      mask-image: var(--hero-fade), linear-gradient(to top, transparent, #000 14%);
      mask-size: 100% 100%;
      mask-repeat: no-repeat;
      mask-composite: intersect;
    }

    /* Софія — лівіше центру кадру: на вузькій панелі (планшет) обличчя не впирається в край */
    .hero__media :global(.hero__photo) {
      object-position: 30% 30%;
    }

    /* Текст — у правій колонці, фото — під лівою. Ліва колонка ширша, щоб текст починався за фейдом фото. */
    .hero__grid {
      grid-template-columns: minmax(0, 11fr) minmax(0, 9fr);
      align-items: center;
      margin-top: 0;
    }

    .hero__text {
      grid-column: 2;
      max-width: 38rem;
    }
  }

  /* Від 64rem — більший відступ між фото і текстом (колонки 3:2) */
  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }
  }
</style>
