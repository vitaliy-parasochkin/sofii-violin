---
import { HANDLES, LINKS } from '../data/site';
import CtaButton from './CtaButton.astro';
import InstagramIcon from './icons/InstagramIcon.astro';
import Sprig from './Sprig.astro';
---

<section class="section section--dark final-cta" id="zapys" aria-labelledby="final-cta-title">
  <div class="container final-cta__grid">
    <div class="final-cta__text">
      <p class="eyebrow">Перший крок</p>
      <h2 id="final-cta-title" class="section-title">Почнімо з <em>безкоштовного уроку</em></h2>
      <p class="final-cta__lead">
        Напишіть мені в Instagram Direct — домовимося про зручний час першого заняття. Воно безкоштовне і ні до чого
        вас не зобов'язує.
      </p>
      <div class="final-cta__actions">
        <CtaButton>Написати в Instagram</CtaButton>
      </div>
    </div>

    <aside class="final-cta__card" aria-label="Контакти">
      <Sprig class="final-cta__sprig" />
      <ul class="final-cta__contacts">
        <li>
          <InstagramIcon />
          <span>Instagram</span>
          <a href={LINKS.instagram} target="_blank" rel="noopener">{HANDLES.instagram}</a>
        </li>
      </ul>
      <p class="final-cta__format">Онлайн · Google Meet · українською<br />Перше заняття — безкоштовне</p>
    </aside>
  </div>
</section>

<style>
  .final-cta__grid {
    display: grid;
    gap: var(--space-xl);
  }

  .final-cta__lead {
    max-width: 34rem;
    margin-top: var(--space-m);
    color: var(--color-muted);
    font-size: var(--text-lg);
  }

  .final-cta__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    margin-top: var(--space-l);
  }

  /* ——— Картка контактів ——— */
  .final-cta__card {
    position: relative;
    align-self: center;
    margin-top: var(--space-s); /* місце для гілочки над карткою */
    padding: var(--space-l) var(--space-m) var(--space-m);
    background-color: var(--color-surface);
    border: var(--border-thin);
    border-radius: var(--radius-s);
    box-shadow: var(--shadow-paper);
  }

  /* :global — клас передається в дочірній компонент */
  .final-cta__card :global(.final-cta__sprig) {
    position: absolute;
    top: -3.25rem;
    left: var(--space-s);
    width: 2.5rem;
    height: auto;
    transform: rotate(-16deg);
  }

  .final-cta__contacts {
    display: grid;
    gap: var(--space-s);
    padding: 0;
    list-style: none;
  }

  .final-cta__contacts li {
    display: grid;
    grid-template-columns: 1.25rem auto 1fr;
    align-items: center;
    gap: var(--space-xs);
  }

  /* :global — svg живе в дочірньому компоненті іконки */
  .final-cta__contacts :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-accent);
  }

  .final-cta__contacts span {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .final-cta__contacts a {
    justify-self: end;
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-style: italic;
  }

  .final-cta__contacts a:hover {
    color: var(--color-accent);
  }

  .final-cta__format {
    margin-top: var(--space-m);
    padding-top: var(--space-s);
    border-top: var(--border-thin);
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-align: center;
  }

  /* ——— Від 30rem кнопки в ряд ——— */
  @media (min-width: 30rem) {
    .final-cta__actions {
      flex-direction: row;
      flex-wrap: wrap;
    }
  }

  /* ——— Планшет і більше: текст зліва, картка справа ——— */
  @media (min-width: 48rem) {
    .final-cta {
      padding-block: var(--space-2xl) var(--space-xl);
    }

    .final-cta__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      align-items: center;
    }

    .final-cta__card {
      margin-top: 0;
      padding: var(--space-l);
      transform: rotate(1.5deg);
    }
  }
</style>
