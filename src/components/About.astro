---
import { Picture } from 'astro:assets';
import aboutPhoto from '../assets/photos/aboutMe.jpg';
import { LINKS } from '../data/site';
import Blossom from './Blossom.astro';
---

<section class="section section--sand about" id="pro-mene" aria-labelledby="about-title">
  <div class="container about__grid">
    <header class="about__head">
      <!-- Великий заголовок прибрано: заголовком секції лишається підпис «Про мене» -->
      <h2 id="about-title" class="eyebrow about__title">Про мене</h2>
    </header>

    <figure class="about__photo taped">
      <Picture
        src={aboutPhoto}
        alt="Софія усміхається і тримає скрипку на тлі квітучого дерева"
        formats={['avif', 'webp']}
        widths={[360, 540, 720, 960, 1440]}
        sizes="(min-width: 75rem) 29rem, (min-width: 48rem) 40vw, min(88vw, 22rem)"
        class="about__photo-img"
      />
    </figure>

    <div class="about__body">
      <p class="about__lead">
        Почати грати на скрипці можна в будь-якому віці. Перевірено моїми дорослими учнями.
      </p>
      <p>
        Найчастіше людей зупиняють думки на кшталт «я вже дорослий», «у мене немає слуху» чи «а раптом не вийде».
        Я це добре розумію, тому на уроках не тисну і не сварю за помилки. Пояснюю простими словами і завжди кажу,
        навіщо ми робимо ту чи іншу вправу.
      </p>
      <p>
        Можна прийти зовсім з нуля або після довгої перерви. Граємо і класику, і сучасне: що вам до душі, те
        й розбираємо. Хто хоче копнути глибше, з тим беремося ще й за теорію музики.
      </p>
      <a class="text-cta about__cta" href={LINKS.instagram} target="_blank" rel="noopener">
        Приходьте на перший урок, він <span class="nowrap">безкоштовний<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M4 12h15M13 6l6 6-6 6" />
          </svg></span>
      </a>
    </div>
  </div>

  <!-- Гілочка лежить на стику з наступною секцією, у смузі відступів -->
  <Blossom class="about__blossom" />
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-areas:
      'head'
      'photo'
      'body';
    gap: var(--space-l);
  }

  .about__head {
    grid-area: head;
  }

  .about__title {
    margin-bottom: 0;
  }

  .about {
    position: relative;
    overflow-x: clip; /* гілочка заходить за правий край екрана */
  }

  /* :global — клас передається в дочірній компонент.
     Половина гілочки — у нижньому відступі цієї секції, половина — у верхньому відступі наступної. */
  .about :global(.about__blossom) {
    position: absolute;
    z-index: 1; /* над фоном наступної секції */
    right: -1rem;
    bottom: -2.75rem;
    width: 6rem;
    height: auto;
    transform: rotate(-12deg);
  }

  /* ——— Фото: полароїд з нахилом і скотчем ——— */
  .about__photo {
    grid-area: photo;
    justify-self: center;
    width: min(100%, 22rem);
    padding: 0.75rem 0.75rem 2rem;
    background-color: var(--color-surface);
    box-shadow: var(--shadow-paper);
    transform: rotate(-1.5deg);
  }

  .about__photo :global(.about__photo-img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ——— Текст ——— */
  .about__body {
    grid-area: body;
    max-width: var(--container-narrow);
  }

  .about__body p + p {
    margin-top: var(--space-s);
  }

  .about__lead {
    margin-bottom: var(--space-m);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-style: italic;
    line-height: var(--leading-snug);
  }

  .about__cta {
    margin-top: var(--space-m);
  }

  /* ——— Планшет і більше: підпис зверху, під ним текст-картка зліва і фото справа ——— */
  @media (min-width: 48rem) {
    .about__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-areas:
        'head head'
        'body photo';
      align-items: center;
      column-gap: var(--space-xl);
      row-gap: var(--space-l);
    }

    .about__photo {
      justify-self: stretch;
      width: auto;
    }

    .about :global(.about__blossom) {
      right: 0;
      bottom: -3rem;
      width: 9rem;
    }

    .about__body {
      padding: var(--space-l);
      background-color: var(--color-surface);
      border: var(--border-thin);
      border-radius: var(--radius-s);
      box-shadow: var(--shadow-paper);
    }
  }
</style>
