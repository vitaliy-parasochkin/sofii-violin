---
// Скрипковий ключ — декоративний, без змісту для скрінрідерів.
// Колір — currentColor (за замовчуванням теракотовий). Розмір і позицію задає батьківський компонент через class.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={['clef', className]}
  viewBox="0 0 60 140"
  width="60"
  height="140"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d="M24 124C30 131 38 127 37 116L31 22C30 10 35 3 40 4C46 6 45 18 38 28C30 40 12 50 12 72C12 90 30 96 40 90C50 84 50 68 38 66C28 64 22 72 26 80" />
  <circle cx="22" cy="121" r="4" fill="currentColor" stroke="none" />
</svg>

<style>
  .clef {
    color: var(--color-accent);
    pointer-events: none;
  }
</style>
