---
import { Picture } from 'astro:assets';
import { LINKS } from '../data/site';
// Кропи — область повідомлення зі сторіз (оригінали 1080×1920 лишаються поруч і відкриваються по кліку).
import shot1 from '../assets/photos/reviews/review1-crop.jpg';
import shot2 from '../assets/photos/reviews/review2-crop.jpg';
import shot3 from '../assets/photos/reviews/review3-crop.jpg';
import shot4 from '../assets/photos/reviews/review4-crop.jpg';
import full1 from '../assets/photos/review1.jpg';
import full2 from '../assets/photos/review2.jpg';
import full3 from '../assets/photos/review3.jpg';
import full4 from '../assets/photos/review4.jpg';

// Відгуки — тільки скрінами, без текстових цитат (рішення 2026-11-10: так правдивіше).
// alt містить текст повідомлення — для скрінрідерів і пошуку (зображення тексту, WCAG 1.1.1).
// Скрін мами Міші — з описом замість цитати (там «їздити на заняття», а уроки тільки онлайн).
const shots = [
  {
    img: shot1,
    full: full1,
    caption: 'Доросла учениця',
    alt: 'Відгук дорослої учениці: «Хочу залишити відгук за рік уроків з Софією, прийшла повна нульова і дуже переймалась, що це буде дуже складно, але вже пройшов рік, і я дуже щаслива і задоволена своїми результатами, дуже дякую за терпіння, за те, що привила любов до скрипки і велику мотивацію продовжувати далі»',
  },
  {
    img: shot2,
    full: full2,
    caption: 'Мама Марусі',
    alt: 'Повідомлення від мами Марусі: «Також скидаю відео, як Маруся вчить свою сестричку грати на скрипці. Дякую дуже за заняття! Бачу, яка дитина задоволена і натхненна»',
  },
  {
    img: shot3,
    full: full3,
    caption: 'Учениця',
    alt: 'Відгук учениці: «Мені дуже подобається займатися скрипкою, на наших заняттях завжди дуже атмосферно та вайбово, мені завжди все зрозуміло, коли мені щось пояснюють, дуже люблю свою викладачку Софію, дякую за уроки»',
  },
  {
    img: shot4,
    full: full4,
    caption: 'Мама Міші',
    alt: 'Листування з мамою Міші: фото хлопчика зі скрипкою, мама дякує і пише, що син дуже любить заняття',
  },
];
---

<section class="section reviews" id="vidguky" aria-labelledby="reviews-title">
  <div class="container">
    <header class="reviews__head">
      <p class="eyebrow">Відгуки</p>
      <h2 id="reviews-title" class="section-title">Що кажуть <em>учні й батьки</em></h2>
      <p class="reviews__intro">Справжні повідомлення від учнів і батьків — такі, як їх надіслали.</p>
    </header>

    <div class="slider" aria-roledescription="карусель" aria-label="Скріншоти відгуків" data-slider>
      <div class="slider__track" data-slider-track>
        {
          shots.map((s, i) => (
            <div class="slider__slide" role="group" aria-roledescription="слайд" aria-label={`${i + 1} з ${shots.length}`}>
              <figure class="shot">
                <a href={s.full.src} class="shot__link">
                  <Picture
                    src={s.img}
                    alt={s.alt}
                    formats={['avif', 'webp']}
                    widths={[320, 480, 640, 800]}
                    sizes="(min-width: 75rem) 23rem, (min-width: 64rem) 30vw, (min-width: 48rem) 44vw, 88vw"
                    class="shot__img"
                  />
                  <span class="visually-hidden"> — відкрити скрін повністю</span>
                </a>
                <figcaption class="shot__caption">{s.caption}</figcaption>
              </figure>
            </div>
          ))
        }
      </div>

      <!-- Стрілки показує скрипт; без JS слайдер гортається прокруткою -->
      <div class="slider__controls" data-slider-controls hidden>
        <button class="slider__btn" type="button" aria-label="Попередній відгук" data-slider-prev>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M20 12H5M11 6l-6 6 6 6" />
          </svg>
        </button>
        <button class="slider__btn" type="button" aria-label="Наступний відгук" data-slider-next>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M4 12h15M13 6l6 6-6 6" />
          </svg>
        </button>
      </div>
    </div>

    <p class="reviews__outro">
      Хочете так само?{' '}
      <a class="text-cta" href={LINKS.instagram} target="_blank" rel="noopener">
        Почніть з безкоштовного <span class="nowrap">уроку<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M4 12h15M13 6l6 6-6 6" />
          </svg></span>
      </a>
    </p>
  </div>
</section>

<style>
  .reviews__intro {
    max-width: 32rem;
    margin-top: var(--space-s);
    color: var(--color-muted);
  }

  /* ——— Слайдер: нативна прокрутка з прилипанням + стрілки (крок — один скрін, по колу) ———
     Видно: телефон — 1, від 48rem — 2, від 64rem — 3. */
  .slider {
    --per-view: 1;
    --slide-gap: var(--space-m);
    margin-top: var(--space-l);
  }

  .slider__track {
    display: flex;
    gap: var(--slide-gap);
    /* Поля, щоб нахил і тінь полароїдів не обрізались краєм прокрутки */
    margin-inline: -0.75rem;
    padding: var(--space-s) 0.75rem var(--space-m);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0.75rem;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .slider__track::-webkit-scrollbar {
    display: none;
  }

  .slider__slide {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--slide-gap)) / var(--per-view));
    scroll-snap-align: start;
  }

  .slider__controls:not([hidden]) {
    display: flex;
    justify-content: center;
    gap: var(--space-s);
    margin-top: var(--space-s);
  }

  .slider__btn {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    background-color: var(--color-surface);
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    color: var(--color-accent-strong);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .slider__btn svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .slider__btn:hover {
    background-color: var(--color-accent-strong);
    color: var(--color-on-accent);
  }

  /* ——— Полароїд ——— */
  .shot {
    padding: 0.75rem 0.75rem 0;
    background-color: var(--color-surface);
    box-shadow: var(--shadow-paper);
    transform: rotate(var(--tilt, -1deg));
    transition: transform var(--duration-base) var(--ease-out);
  }

  .slider__slide:nth-child(even) .shot {
    --tilt: 1deg;
  }

  .shot__link {
    display: block;
  }

  .shot :global(.shot__img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .shot__caption {
    padding-block: 0.6rem 0.7rem;
    color: var(--color-muted);
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-style: italic;
    text-align: center;
  }

  @media (hover: hover) and (pointer: fine) {
    .shot:hover {
      transform: rotate(0deg) translateY(-4px);
    }
  }

  .reviews__outro {
    margin-top: var(--space-l);
    color: var(--color-muted);
    text-align: center;
  }

  @media (min-width: 48rem) {
    .slider {
      --per-view: 2;
      --slide-gap: var(--space-l);
      margin-top: var(--space-xl);
    }
  }

  @media (min-width: 64rem) {
    .slider {
      --per-view: 3;
    }
  }
</style>

<script>
  // Нескінченний слайдер (loop): скрипт додає копії всіх скрінів перед і після справжніх.
  // Після останнього «→» плавно показується копія першого, а потім — непомітний стрибок на справжній перший
  // (так само в інший бік і при свайпі). Крок — один скрін. Без JS — звичайна прокрутка без копій.
  for (const slider of document.querySelectorAll<HTMLElement>('[data-slider]')) {
    const track = slider.querySelector<HTMLElement>('[data-slider-track]');
    const controls = slider.querySelector<HTMLElement>('[data-slider-controls]');
    const prev = slider.querySelector<HTMLButtonElement>('[data-slider-prev]');
    const next = slider.querySelector<HTMLButtonElement>('[data-slider-next]');
    if (!track || !controls || !prev || !next) continue;

    const real = [...track.children] as HTMLElement[];
    const n = real.length;
    if (n < 2) continue;

    // Копії — тільки для вигляду: приховані від скрінрідерів і клавіатури
    const makeClone = (slide: HTMLElement) => {
      const clone = slide.cloneNode(true) as HTMLElement;
      clone.setAttribute('aria-hidden', 'true');
      clone.removeAttribute('role');
      clone.removeAttribute('aria-roledescription');
      clone.removeAttribute('aria-label');
      clone.inert = true;
      return clone;
    };
    track.prepend(...real.map(makeClone));
    track.append(...real.map(makeClone));

    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const slides = track.children as HTMLCollectionOf<HTMLElement>;
    // Дробовий крок (offsetLeft округлює до пікселя, і похибка накопичувалась би)
    const step = () => slides[1].getBoundingClientRect().left - slides[0].getBoundingClientRect().left;

    // Логічний індекс у треку з копіями: справжні скріни — n…2n−1
    let index = n;
    let moving = false;
    let fallback = 0;

    const scrollToIndex = (i: number, smooth: boolean) => {
      index = i;
      moving = smooth;
      track.scrollTo({ left: i * step(), behavior: smooth && !reduceMotion.matches ? 'smooth' : 'instant' });
      // Запасний варіант, якщо браузер не надішле кінця прокрутки
      clearTimeout(fallback);
      if (smooth) fallback = window.setTimeout(() => moving && settle(), 900);
    };

    // Якщо стоїмо на копії — непомітно переставляємо на той самий справжній скрін
    const normalize = () => {
      if (index < n) scrollToIndex(index + n, false);
      else if (index >= 2 * n) scrollToIndex(index - n, false);
    };

    const go = (dir: 1 | -1) => {
      if (!moving) index = Math.round(track.scrollLeft / step());
      normalize();
      scrollToIndex(index + dir, true);
    };

    function settle() {
      clearTimeout(fallback);
      moving = false;
      index = Math.round(track.scrollLeft / step());
      normalize();
    }

    if ('onscrollend' in window) {
      track.addEventListener('scrollend', settle);
    } else {
      let timer = 0;
      track.addEventListener(
        'scroll',
        () => {
          clearTimeout(timer);
          timer = window.setTimeout(settle, 150);
        },
        { passive: true },
      );
    }

    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    addEventListener('resize', () => scrollToIndex(index, false));

    scrollToIndex(n, false);
    controls.hidden = false;
  }
</script>
