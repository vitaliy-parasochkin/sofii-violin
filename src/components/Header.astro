---
// Хедер для всіх сторінок (підключений у BaseLayout): логотип «S» ліворуч, меню секцій по центру.
// На сторінці з hero — схований у самому верху сторінки і виїжджає, щойно користувач почав прокрутку (рішення 2026-11-12).
// Без JS або без hero — звичайний sticky-хедер.
// (без назви бренду, кнопки запису і лінії прогресу — рішення 2026-11-10).
// Телефон і планшет: кнопка праворуч, меню на весь екран під хедером (popover — без JS). Від 64rem: меню в ряд.
// Активний пункт меню оновлює скрипт у SectionProgress.astro (тільки на головній).
import { SECTIONS } from '../data/sections';
import Logo from './Logo.astro';

const navItems = SECTIONS.filter((s) => s.nav);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__logo" href="/#top" aria-label="Sofii Violin — на початок сторінки">
      <Logo />
    </a>

    <nav class="site-header__nav" aria-label="Розділи сторінки">
      <button class="site-header__menu-btn" type="button" popovertarget="site-menu" aria-label="Меню">
        <span class="site-header__burger" aria-hidden="true"></span>
      </button>

      <ul class="site-header__menu" id="site-menu" popover>
        {
          navItems.map((item) => (
            <li>
              <a href={`/#${item.id}`} data-nav-link={item.id}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background-color: var(--color-bg);
    background-image: var(--paper-texture);
    border-bottom: var(--border-thin);
  }

  /* ——— Сторінка з hero: фіксований, схований у самому верху сторінки ——— */
  :global(html.js:has(.hero)) .site-header {
    position: fixed;
    inset: 0 0 auto;
    translate: 0 -100%;
    visibility: hidden;
    transition:
      translate var(--duration-base) var(--ease-out),
      visibility 0s linear var(--duration-base);
  }

  :global(html.js:has(.hero)) .site-header.is-visible,
  :global(html.js:has(.hero)) .site-header:has(:popover-open) {
    translate: none;
    visibility: visible;
    box-shadow: 0 8px 24px -16px rgb(59 42 32 / 0.35);
    transition:
      translate var(--duration-base) var(--ease-out),
      visibility 0s;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between; /* телефон: логотип ліворуч, кнопка меню праворуч */
    height: var(--header-h);
  }

  .site-header__logo {
    display: block;
    border-radius: 10px;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .site-header__logo :global(.logo) {
    width: 2.5rem;
    height: 2.5rem;
  }

  .site-header__logo:hover {
    transform: rotate(-4deg);
  }

  /* ——— Кнопка меню (бургер → хрестик) ——— */
  .site-header__menu-btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    background: none;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    color: var(--color-text);
    cursor: pointer;
  }

  .site-header__burger,
  .site-header__burger::before,
  .site-header__burger::after {
    display: block;
    width: 1.1rem;
    height: 1.5px;
    background-color: currentColor;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .site-header__burger {
    position: relative;
  }

  .site-header__burger::before,
  .site-header__burger::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .site-header__burger::before {
    top: -6px;
  }

  .site-header__burger::after {
    top: 6px;
  }

  .site-header__nav:has(.site-header__menu:popover-open) .site-header__burger {
    background-color: transparent;
  }

  .site-header__nav:has(.site-header__menu:popover-open) .site-header__burger::before {
    transform: translateY(6px) rotate(45deg);
  }

  .site-header__nav:has(.site-header__menu:popover-open) .site-header__burger::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ——— Меню на весь екран (popover) ———
     Від низу хедера до низу екрана: хедер з хрестиком лишається видимим над меню. */
  .site-header__menu {
    position: fixed;
    inset: var(--header-h) 0 0;
    width: auto;
    height: auto;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: var(--space-l) var(--gutter) calc(var(--space-xl) + env(safe-area-inset-bottom));
    overflow-y: auto;
    list-style: none;
    background-color: var(--color-bg);
    background-image: var(--paper-texture);
    border: 0;
    color: var(--color-text);
    text-align: center;
  }

  @media (max-width: 63.99rem) {
    .site-header__menu:popover-open {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: var(--space-2xs);
    }
  }

  .site-header__menu a {
    display: block;
    padding-block: var(--space-xs);
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    text-decoration: none;
  }

  /* Поки меню відкрите, сторінка під ним не прокручується */
  :global(html:has(#site-menu:popover-open)) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header__menu:popover-open {
      animation: menu-in var(--duration-base) var(--ease-out);
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
    }
  }

  .site-header__menu a.is-active {
    color: var(--color-accent-strong);
    font-style: italic;
  }

  /* ——— Широкий екран: меню в ряд, без кнопки ——— */
  @media (min-width: 64rem) {
    /* Три колонки: логотип | меню рівно по центру сторінки | порожня (для симетрії) */
    .site-header__inner {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }

    .site-header__menu-btn {
      display: none;
    }

    /* popover ніколи не відкривається — показуємо список як звичайний */
    .site-header__menu {
      position: static;
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: var(--space-l);
      padding: 0;
      overflow: visible;
      background: none;
      border: 0;
      box-shadow: none;
    }

    .site-header__menu a {
      padding-block: var(--space-2xs);
      font-family: var(--font-body);
      font-size: var(--text-sm);
    }

    :global(html:has(#site-menu:popover-open)) {
      overflow: visible;
    }

    .site-header__menu a:hover {
      color: var(--color-accent-strong);
    }

    .site-header__menu a.is-active {
      font-style: normal;
      text-decoration: underline;
      text-decoration-color: var(--color-accent);
    }
  }
</style>

<script>
  // Показати хедер, щойно користувач почав прокрутку; сховати, коли повернувся в самий верх.
  // Поріг 8px — щоб випадковий мікрорух на тачпаді не смикав хедер.
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header && document.querySelector('.hero')) {
    let frame = 0;
    const update = () => header.classList.toggle('is-visible', scrollY > 8);
    addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(update);
      },
      { passive: true },
    );
    update(); // сторінку могли відкрити вже прокрученою (якір, перезавантаження)
  }

  // Закрити меню після вибору пункту (плавна прокрутка — через CSS).
  const menu = document.getElementById('site-menu');
  menu?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a') && menu.matches(':popover-open')) menu.hidePopover();
  });
</script>
