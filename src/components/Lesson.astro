---
import { Picture } from 'astro:assets';
import meetPhoto from '../assets/photos/lesson-meet.jpg';
import CtaButton from './CtaButton.astro';
import Notes from './Notes.astro';
import Staff from './Staff.astro';

const needs = ['Скрипка і смичок', 'Ноутбук або телефон', 'Стабільний інтернет', '50 хвилин, коли вас ніхто не смикає'];

const steps = [
  {
    title: 'Постановка рук',
    text: 'Дивлюся, як ви тримаєте скрипку і смичок. Якщо десь затискаєтесь, виправляємо, щоб грати було зручно.',
  },
  {
    title: 'Вправи на техніку',
    text: 'Трохи гам і вправ на чистий звук. Без фанатизму, рівно стільки, скільки треба на вашому етапі.',
  },
  {
    title: 'Ваш твір',
    text: 'Найприємніша частина. Граємо те, що ви обрали самі, хоч класику, хоч сучасну пісню.',
  },
  {
    title: 'Підсумки і завдання',
    text: 'Кажу, що вже добре виходить, і даю завдання до наступного уроку.',
  },
];
---

<section class="section section--dark lesson" id="yak-prokhodyt-urok" aria-labelledby="lesson-title">
  <!-- Нотна лінійка лежить на стику з попередньою секцією, у смузі відступів -->
  <Staff class="lesson__staff" />
  <div class="container lesson__grid">
    <header class="lesson__head">
      <h2 id="lesson-title" class="eyebrow">Як проходить онлайн-урок</h2>
      <Notes class="lesson__notes" />
    </header>

    <!-- Фото і «Що знадобиться» — поруч, як два полароїди з різним нахилом -->
    <div class="lesson__intro">
      <figure class="lesson__photo taped" style="--tape-shift: -25%; --tape-tilt: -6deg">
        <Picture
          src={meetPhoto}
          alt="Ноутбук з відкритим Google Meet: на екрані Софія зі скрипкою, на передньому плані ноти"
          formats={['avif', 'webp']}
          widths={[360, 540, 720, 1034]}
          sizes="(min-width: 75rem) 36rem, (min-width: 48rem) 50vw, (min-width: 30rem) 24rem, 88vw"
          class="lesson__photo-img"
        />
        <figcaption class="lesson__photo-caption">А так я виглядаю з вашого боку екрана</figcaption>
      </figure>

      <div class="lesson__needs">
        <h3 class="lesson__subtitle">Що знадобиться</h3>
        <ul class="lesson__checklist">
          {
            needs.map((item) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                  <path d="m5 12.5 4.5 4.5L19 7" />
                </svg>
                {item}
              </li>
            ))
          }
        </ul>
        <p class="lesson__meet">
          За 5 хвилин до уроку надішлю вам посилання на Google Meet. Воно відкривається просто в браузері.
        </p>
      </div>
    </div>

    <div class="lesson__flow">
      <h3 class="lesson__subtitle">Як минають 50 хвилин</h3>
      <ol class="lesson__steps">
        {
          steps.map((step, i) => (
            <li class="lesson__step">
              <span class="lesson__num" aria-hidden="true">{i + 1}</span>
              <h4 class="lesson__step-title">{step.title}</h4>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="lesson__cta">
        <CtaButton />
        <p>Перший урок безкоштовний.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .lesson__grid {
    display: grid;
    gap: var(--space-xl);
  }

  .lesson {
    position: relative;
    overflow-x: clip; /* лінійка заходить за лівий край екрана */
  }

  /* :global — клас передається в дочірній компонент */
  .lesson :global(.lesson__staff) {
    position: absolute;
    z-index: 1; /* над фоном попередньої секції */
    top: -1.75rem;
    left: -2.5rem;
    width: 15rem;
    height: auto;
    opacity: 0.8;
    transform: rotate(-4deg);
  }

  @media (min-width: 48rem) {
    .lesson :global(.lesson__staff) {
      top: -2.5rem;
      width: 22rem;
    }
  }

  .lesson__head {
    position: relative;
  }

  /* :global — клас передається в дочірній компонент. Ноти — лише там, де праворуч від заголовка є місце */
  .lesson__head :global(.lesson__notes) {
    display: none;
  }

  .lesson__subtitle {
    margin-bottom: var(--space-m);
    font-size: var(--text-xl);
  }

  .lesson__intro {
    display: grid;
    gap: var(--space-l);
  }

  /* ——— Фото з уроку: світлий полароїд на темному тлі ——— */
  .lesson__photo {
    justify-self: center;
    width: min(100%, 24rem);
    padding: 0.75rem 0.75rem 0;
    background-color: #fbf7f0; /* «папір» світлої теми: на темному тлі --color-surface темний */
    box-shadow: var(--shadow-paper);
    transform: rotate(1.5deg);
  }

  .lesson__photo :global(.lesson__photo-img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .lesson__photo-caption {
    padding-block: 0.6rem 0.7rem;
    color: var(--color-espresso);
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-style: italic;
    text-align: center;
  }

  /* ——— Що знадобиться: «паперова» картка ——— */
  .lesson__needs {
    padding: var(--space-m);
    background-color: var(--color-surface);
    border: var(--border-thin);
    border-radius: var(--radius-s);
    box-shadow: var(--shadow-paper);
  }

  .lesson__checklist {
    display: grid;
    gap: var(--space-xs);
    padding: 0;
    list-style: none;
  }

  .lesson__checklist li {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
  }

  .lesson__checklist svg {
    flex-shrink: 0;
    width: 1.1em;
    height: 1.1em;
    color: var(--color-accent);
    transform: translateY(0.18em);
  }

  .lesson__meet {
    margin-top: var(--space-m);
    padding-top: var(--space-s);
    border-top: var(--border-thin);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  /* ——— 50 хвилин: телефон — кроки з вертикальною лінією ——— */
  .lesson__steps {
    padding: 0;
    list-style: none;
  }

  .lesson__step {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    column-gap: var(--space-s);
    padding-bottom: var(--space-m);
  }

  /* Лінія між номерами */
  .lesson__step:not(:last-child)::before {
    content: '';
    position: absolute;
    top: 3rem;
    bottom: 0.25rem;
    left: calc(1.375rem - 0.5px);
    width: 1px;
    background-color: var(--color-line);
  }

  .lesson__num {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-style: italic;
    line-height: 1;
  }

  .lesson__step-title {
    align-self: center;
    font-size: var(--text-lg);
  }

  .lesson__step p {
    margin-top: var(--space-3xs);
    color: var(--color-muted);
  }

  .lesson__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-m);
    margin-top: var(--space-m);
  }

  .lesson__cta p {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  /* ——— Планшет і більше: фото й картка поруч, кроки — сіткою ——— */
  @media (min-width: 48rem) {
    .lesson__head :global(.lesson__notes) {
      display: block;
      position: absolute;
      top: calc(-1 * var(--space-m));
      right: var(--space-s);
      width: 6rem;
      height: auto;
      opacity: 0.55;
      transform: rotate(8deg);
    }

    .lesson__intro {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      column-gap: var(--space-xl);
      align-items: center;
    }

    /* Тільки екран з уроком (без клавіатури), щоб фото було одного зросту з карткою */
    .lesson__photo {
      justify-self: stretch;
      width: auto;
    }

    .lesson__photo :global(.lesson__photo-img) {
      aspect-ratio: 4 / 3;
      object-fit: cover;
      object-position: 50% 0;
    }

    .lesson__needs {
      padding: var(--space-l);
      transform: rotate(-1deg); /* «живий» нахил, як у полароїда */
    }

    .lesson__steps {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-m) var(--space-l);
    }

    .lesson__step {
      padding-bottom: 0;
    }

    .lesson__step::before {
      display: none;
    }

    .lesson__cta {
      justify-content: center;
      margin-top: var(--space-l);
    }
  }

  /* ——— Широкий екран: 4 кроки в ряд, номери з'єднує горизонтальна лінія ——— */
  @media (min-width: 64rem) {
    .lesson__steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: var(--space-m);
    }

    .lesson__step {
      grid-template-columns: minmax(0, 1fr);
      align-content: start; /* інакше зайва висота сусіднього кроку розтягує рядки */
    }

    .lesson__num {
      grid-row: auto;
      margin-bottom: var(--space-s);
    }

    .lesson__step-title {
      align-self: start;
    }

    .lesson__step:not(:last-child)::before {
      display: block;
      top: calc(1.375rem - 0.5px);
      bottom: auto;
      left: calc(2.75rem + var(--space-xs));
      right: calc(var(--space-xs) - var(--space-m));
      width: auto;
      height: 1px;
    }
  }
</style>
