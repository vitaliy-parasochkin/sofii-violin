---
// Футер для всіх сторінок (підключений у BaseLayout).
import { LINKS, SITE } from '../data/site';
import InstagramIcon from './icons/InstagramIcon.astro';
import TelegramIcon from './icons/TelegramIcon.astro';

const year = new Date().getFullYear();
---

<footer class="section--dark site-footer">
  <div class="container">
    <div class="site-footer__inner">
      <p class="site-footer__brand">
        <span class="site-footer__name">{SITE.name}</span>
        <span class="site-footer__tagline">Уроки скрипки онлайн для дорослих і дітей</span>
      </p>

      <ul class="site-footer__social">
        <li>
          <a href={LINKS.instagram} target="_blank" rel="noopener" aria-label="Instagram Sofii Violin">
            <InstagramIcon />
          </a>
        </li>
        <li>
          <a href={LINKS.telegram} target="_blank" rel="noopener" aria-label="Telegram Sofii Violin">
            <TelegramIcon />
          </a>
        </li>
      </ul>

      <p class="site-footer__copy">© {year} {SITE.name}</p>
    </div>
  </div>
</footer>

<style>
  /* Компактний футер: телефон — назва й іконки в рядок, © під ними; десктоп — усе в один рядок */
  .site-footer {
    padding-block: var(--space-m);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'brand social'
      'copy  copy';
    align-items: center;
    gap: var(--space-xs) var(--space-m);
  }

  .site-footer__brand {
    grid-area: brand;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-s);
  }

  .site-footer__name {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-style: italic;
  }

  .site-footer__tagline,
  .site-footer__copy {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .site-footer__copy {
    grid-area: copy;
  }

  .site-footer__social {
    grid-area: social;
    display: flex;
    gap: var(--space-xs);
    padding: 0;
    list-style: none;
  }

  /* Іконки — з полем ≥ 44px для пальця */
  .site-footer__social a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    color: var(--color-accent);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out);
  }

  .site-footer__social a:hover {
    border-color: var(--color-accent);
    background-color: rgb(224 160 122 / 0.12);
  }

  /* :global — svg живе в дочірньому компоненті іконки */
  .site-footer__social :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  @media (min-width: 48rem) {
    .site-footer__inner {
      grid-template-columns: minmax(0, 1fr) auto auto;
      grid-template-areas: 'brand copy social';
      column-gap: var(--space-l);
    }
  }
</style>
